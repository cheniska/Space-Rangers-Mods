          "#": 140,
          "Code.Type": "Turn",
          "Code": [
            "dJumpQuestBegin=1;",
            "if (RelationToRanger(Planet2,Player())<50){",
            "RelationToRanger(Planet2,Player(),50);}",
            "Ether(3,'4F6C2F29-4A02-46E9-BF8B-467EC1EC4246',\"Задание!<br>Совершить гиперпрыжок в систему <Name(Star2)>. Сесть на планету <Name(Planet2)>, там дозаправиться и нанести визит к инструктору в здание правительства.\");"
          ]
