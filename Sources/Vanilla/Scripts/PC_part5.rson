        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 1374,
          "Pos.y": 1130,
          "Parent": -1,
          "#": 256,
          "Msg": "Предпочитаю побеседовать с атаманом. На этот раз его ничто не спасет!",
          "AMsg.Num": "25"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 1414,
          "Pos.y": 1190,
          "Parent": -1,
          "#": 257,
          "Msg": "Ну, тогда за дело.",
          "AMsg.Num": "26"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 1374,
          "Pos.y": 1190,
          "Parent": -1,
          "#": 258,
          "Msg": "Ничего, я справлюсь. За дело!",
          "AMsg.Num": "27"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 0,
          "Pos.y": 1010,
          "Parent": -1,
          "#": 259,
          "Msg": "Мы столкнулись с доминаторами, которые помешали нам устранить атамана.",
          "AMsg.Num": "28"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 40,
          "Pos.y": 1010,
          "Parent": -1,
          "#": 260,
          "Msg": "Атаман успешно засажен в тюрьму, надежно и надолго. Миссия выполнена!",
          "AMsg.Num": "29"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "hangar",
          "Pos.x": 80,
          "Pos.y": 1070,
          "Parent": -1,
          "#": 261,
          "Msg": "Понял, уже вылетаю.",
          "AMsg.Num": "30"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 1134,
          "Pos.y": 1010,
          "Parent": -1,
          "#": 262,
          "Msg": "Если такой умный, то попробуй сам!",
          "AMsg.Num": "31"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 1134,
          "Pos.y": 1070,
          "Parent": -1,
          "#": 263,
          "Msg": "Конец связи",
          "AMsg.Num": "32"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 1950,
          "Pos.y": 1040,
          "Parent": -1,
          "#": 264,
          "Msg": "Уже лечу!",
          "AMsg.Num": "33"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 1294,
          "Pos.y": 1040,
          "Parent": -1,
          "#": 265,
          "Msg": "Просто не получилось. Давай попробуем еще разок.",
          "AMsg.Num": "34"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 214,
          "Pos.y": 1070,
          "Parent": -1,
          "#": 266,
          "Msg": "Что ты знаешь о нашей миссии?",
          "AMsg.Num": "35"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 254,
          "Pos.y": 1070,
          "Parent": -1,
          "#": 267,
          "Msg": "Почему у тебя такое странное имя, мистер Шу?",
          "AMsg.Num": "36"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 324,
          "Pos.y": 1070,
          "Parent": -1,
          "#": 268,
          "Msg": "Кто ты такой?",
          "AMsg.Num": "37"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 414,
          "Pos.y": 1070,
          "Parent": -1,
          "#": 269,
          "Msg": "Расскажи что-нибудь интересное, а?",
          "AMsg.Num": "38"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 454,
          "Pos.y": 1160,
          "Parent": -1,
          "#": 270,
          "Msg": "Ладно... Конец связи.",
          "AMsg.Num": "39"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 354,
          "Pos.y": 1160,
          "Parent": -1,
          "#": 271,
          "Msg": "То есть?",
          "AMsg.Num": "40"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 354,
          "Pos.y": 1220,
          "Parent": -1,
          "#": 272,
          "Msg": "Как туда попасть?",
          "AMsg.Num": "41"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 374,
          "Pos.y": 1280,
          "Parent": -1,
          "#": 273,
          "Msg": "Ладно... Конец связи.",
          "AMsg.Num": "42"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 235,
          "Pos.y": 1430,
          "Parent": -1,
          "#": 274,
          "Msg": "Так и есть. И уже совсем скоро я займу это место! Надеюсь, ты не против?",
          "AMsg.Num": "43"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 310,
          "Pos.y": 1430,
          "Parent": -1,
          "#": 275,
          "Msg": "Дело не в этом. Ты предал наши идеалы, а потому подлежишь ликвидации!",
          "AMsg.Num": "44"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 200,
          "Pos.y": 1490,
          "Parent": -1,
          "#": 276,
          "Msg": "Что ты имеешь в виду?",
          "AMsg.Num": "45"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 270,
          "Pos.y": 1490,
          "Parent": -1,
          "#": 277,
          "Msg": "Это слова труса и предателя! Ты не достоин жить!",
          "AMsg.Num": "46"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 200,
          "Pos.y": 1550,
          "Parent": -1,
          "#": 278,
          "Msg": "Сильные слова. Но можешь ли ты за них ответить?",
          "AMsg.Num": "47"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 170,
          "Pos.y": 1610,
          "Parent": -1,
          "#": 279,
          "Msg": "После того, как ты это сказал, я начинаю понимать, что и сам всегда подозревал это. Но почему больше никто этого не замечает?",
          "AMsg.Num": "48"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 230,
          "Pos.y": 1610,
          "Parent": -1,
          "#": 280,
          "Msg": "Я не верю тебе. Умри, лжец!",
          "AMsg.Num": "49"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 150,
          "Pos.y": 1670,
          "Parent": -1,
          "#": 281,
          "Msg": "Я принял решение. Считай, что официально ты мертв. Надеюсь, никто и никогда не узнает, об этом. Желаю удачи в твоем расследовании.",
          "AMsg.Num": "50"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 190,
          "Pos.y": 1670,
          "Parent": -1,
          "#": 282,
          "Msg": "Я принял решение. Та чушь, которую ты мне рассказал, является наглой ложью, а потому я выполню то, зачем меня сюда прислали!",
          "AMsg.Num": "51"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 390,
          "Pos.y": 1430,
          "Parent": -1,
          "#": 283,
          "Msg": "Ну, раз ты просишь, то ладно, уничтожу.",
          "AMsg.Num": "52"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 450,
          "Pos.y": 1430,
          "Parent": -1,
          "#": 284,
          "Msg": "Нет, я не могу на это пойти.",
          "AMsg.Num": "53"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 430,
          "Pos.y": 1520,
          "Parent": -1,
          "#": 285,
          "Msg": "Звучит убедительно. Выполняю приказ.",
          "AMsg.Num": "54"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 470,
          "Pos.y": 1520,
          "Parent": -1,
          "#": 286,
          "Msg": "Я не меняю своего решения. Атаман Макаров останется жить.",
          "AMsg.Num": "55"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "exit",
          "Pos.x": 470,
          "Pos.y": 1610,
          "Parent": -1,
          "#": 287,
          "Msg": "Ну ты размечтался!",
          "AMsg.Num": "56"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 896,
          "Pos.y": 620,
          "Parent": -1,
          "#": 288,
          "Msg": "Увы, нет.",
          "AMsg.Num": "57"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 983,
          "Pos.y": 620,
          "Parent": -1,
          "#": 289,
          "Msg": "Кое-что удалось разузнать.",
          "AMsg.Num": "58"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 943,
          "Pos.y": 620,
          "Parent": -1,
          "#": 290,
          "Msg": "Думаю, у меня неплохой улов.",
          "AMsg.Num": "59"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "planet",
          "Pos.x": 896,
          "Pos.y": 710,
          "Parent": -1,
          "#": 291,
          "Msg": "Да, она нам всем еще пригодится.",
          "AMsg.Num": "60"
        },
        {
          "Type": "TDialogAnswer",
