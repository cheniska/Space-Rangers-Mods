          "Pos.y": 1070,
          "Parent": -1,
          "#": 254,
          "Msg": "Какую еще атаку?",
          "AMsg.Num": "23"
        },
        {
          "Type": "TDialogAnswer",
          "Name": "",
          "Pos.x": 1414,
          "Pos.y": 1130,
          "Parent": -1,
          "#": 255,
          "Msg": "Беру генерала-дипломата на себя. Будет весело.",
