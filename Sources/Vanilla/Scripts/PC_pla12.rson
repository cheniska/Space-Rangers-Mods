      "Operations": [
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 155,
          "Pos.y": 85,
          "Parent": -1,
          "#": 15,
          "Code.Type": "Init",
          "Code": [
            "counter=1;",
            "while (counter<ArrayDim(array_script_names)){",
            "if (array_chosen_planets[counter]==Id(PlanetNew)){script_num=counter;}",
            "counter=counter+1;}"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 235,
          "Pos.y": 85,
          "Parent": -1,
          "#": 16,
          "Code.Type": "Turn",
          "Code": [
            "if (!quest_started && ShipIsTakeoff(Player())){",
            "ShipOut(Player());}",
            "if(quest_started && !quest_complete) {",
            "  PlanetSetGoods(PlanetNew,t_Food,0);",
            "  PlanetSetGoods(PlanetNew,t_Technics,0);",
            "}",
            "if(quest_started && !quest_complete && !quest_failed && (CurTurn()>quest_deadline)) {",
            "  array_quest_statuses[script_num]=3;",
            "  quest_failed=1;",
            "  ShipOut(Player());",
            "  Ether(5,'6ADA2AC7-5598-41B9-A02C-E49C68F8145D',\"Время истекло, задание провалено. Теперь на поддержку правителя планеты <Name(PlanetNew)> можно не рассчитывать.\");",
            "}"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 315,
          "Pos.y": 85,
          "Parent": -1,
          "#": 17,
          "Code.Type": "DialogBegin",
          "Code": [
            "if(GetShipPlanet(Player())==PlanetNew) {",
            "  if(!quest_started) {",
            "    if(request_dialog) {",
            "      request_dialog=0;",
            "      AddDialogOverride('DialogPlanet',10);",
            "    }",
            "  }",
            "  if(quest_started && !quest_failed) {",
            "    if(food_collected<req_count) {",
            "      AddDialogInject('DialogPlanetFood','',\"Я привез партию продовольствия\",10);",
            "    }",
            "    if(tech_collected<req_count) {",
            "      AddDialogInject('DialogPlanetTech','',\"Я привез партию техники\",10);",
            "    }",
            "  }",
            "}"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 30,
          "Pos.y": 295,
          "Parent": -1,
          "#": 36,
          "Code.Type": "Turn",
          "Code": [
            "quest_deadline=CurTurn()+120;"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 280,
          "Pos.y": 295,
          "Parent": -1,
          "#": 37,
          "Code.Type": "Turn",
          "Code": [
            "cargo_food=GoodsCount(Player(),t_Food);"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 486,
          "Pos.y": 295,
          "Parent": -1,
          "#": 38,
          "Code.Type": "Turn",
          "Code": [
            "cargo_tech=GoodsCount(Player(),t_Technics);"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 0,
          "Pos.y": 385,
          "Parent": -1,
          "#": 39,
          "Code.Type": "Turn",
          "Code": [
            "PlanetSetGoods(PlanetNew,t_Food,0);",
            "PlanetSetGoods(PlanetNew,t_Technics,0);",
            "DecayGoods(PlanetNew,t_Food);",
            "DecayGoods(PlanetNew,t_Technics);",
            "array_quest_statuses[script_num]=1;",
            "quest_started=1;",
            "Ether(3,'6ADA2AC7-5598-41B9-A02C-E49C68F8145D',\"Особое задание правителя планеты <Name(PlanetNew)> системы <Name(StarNew)><br><br>Добыть <req_count> тонн техники и продовольствия.<br><br>Крайний срок - <GameDateTxtByTurn(quest_deadline)>.\");"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 218,
          "Pos.y": 355,
          "Parent": -1,
          "#": 44,
          "Code.Type": "Turn",
          "Code": [
            "if (cargo_food>(req_count-food_collected)){cargo_food=req_count-food_collected;}",
            "food_collected=food_collected+cargo_food;",
            "ShipGoods(Player(),t_Food,-cargo_food);"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 235,
          "Pos.y": 445,
          "Parent": -1,
          "#": 45,
          "Code.Type": "Turn",
          "Code": [
            "array_quest_statuses[script_num]=2;",
            "khan_counter=khan_counter+1;",
            "quest_complete=1;",
            "ShipOut(Player());",
            "Ether(4,'6ADA2AC7-5598-41B9-A02C-E49C68F8145D',\"Задание выполнено, поддержка правителя планеты <Name(PlanetNew)> получена!\");"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 543,
          "Pos.y": 355,
          "Parent": -1,
          "#": 50,
          "Code.Type": "Turn",
          "Code": [
            "if (cargo_tech>(req_count-tech_collected)){cargo_tech=req_count-tech_collected;}",
            "tech_collected=tech_collected+cargo_tech;",
            "ShipGoods(Player(),t_Technics,-cargo_tech);"
          ]
        },
        {
