                    [
                        "GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 305,
                    "Parent": -1,
                    "#": 13,
                    "Code.Type": "Init",
                    "Code": 
                    [
                        "HardSkillsArr0=newarray(7);",
                        "//HardSkillsArr0[0-2] - s.exp",
                        "//HardSkillsArr0[3-5] - s.up_count",
                        "//HardSkillsArr0[6] - check exp 1/0",
                        "for(i=0;i<7;i=i+1)HardSkillsArr0[i]=0;",
                        "HardSkillsArr2=newarray(6);",
                        "//HardSkillsArr2[0-2] - s.exp",
                        "//HardSkillsArr2[3-5] - s.up_count",
                        "for(i=0;i<6;i=i+1)HardSkillsArr2[i]=0;",
                        "HardSkillsArr1=newarray(6,8);",
                        "//acc",
                        "HardSkillsArr1[0,0]=0;",
                        "HardSkillsArr1[0,1]=2000;",
                        "HardSkillsArr1[0,2]=6000;",
                        "HardSkillsArr1[0,3]=13500;",
                        "HardSkillsArr1[0,4]=27500;",
                        "HardSkillsArr1[0,5]=54000;",
                        "HardSkillsArr1[0,6]=104000;",
                        "HardSkillsArr1[0,7]=0;",
                        "//mob",
                        "HardSkillsArr1[1,0]=0;",
                        "HardSkillsArr1[1,1]=2000;",
                        "HardSkillsArr1[1,2]=6000;",
                        "HardSkillsArr1[1,3]=13500;",
                        "HardSkillsArr1[1,4]=27500;",
                        "HardSkillsArr1[1,5]=54000;",
                        "HardSkillsArr1[1,6]=104000;",
                        "HardSkillsArr1[1,7]=0;",
                        "//tech",
                        "HardSkillsArr1[2,0]=0;",
                        "HardSkillsArr1[2,1]=1600;",
                        "HardSkillsArr1[2,2]=4800;",
                        "HardSkillsArr1[2,3]=10800;",
                        "HardSkillsArr1[2,4]=22000;",
                        "HardSkillsArr1[2,5]=43200;",
                        "HardSkillsArr1[2,6]=83200;",
                        "HardSkillsArr1[2,7]=0;",
                        "//trd",
                        "HardSkillsArr1[3,0]=0;",
                        "HardSkillsArr1[3,1]=1600;",
                        "HardSkillsArr1[3,2]=4800;",
                        "HardSkillsArr1[3,3]=10800;",
                        "HardSkillsArr1[3,4]=22000;",
                        "HardSkillsArr1[3,5]=43200;",
                        "HardSkillsArr1[3,6]=83200;",
                        "HardSkillsArr1[3,7]=0;",
                        "//chrm",
                        "HardSkillsArr1[4,0]=0;",
                        "HardSkillsArr1[4,1]=1200;",
                        "HardSkillsArr1[4,2]=3600;",
                        "HardSkillsArr1[4,3]=8100;",
                        "HardSkillsArr1[4,4]=16500;",
                        "HardSkillsArr1[4,5]=32400;",
                        "HardSkillsArr1[4,6]=62400;",
                        "HardSkillsArr1[4,7]=0;",
                        "//ldr",
                        "HardSkillsArr1[5,0]=0;",
                        "HardSkillsArr1[5,1]=1200;",
                        "HardSkillsArr1[5,2]=3600;",
                        "HardSkillsArr1[5,3]=8100;",
                        "HardSkillsArr1[5,4]=16500;",
                        "HardSkillsArr1[5,5]=32400;",
                        "HardSkillsArr1[5,6]=62400;",
                        "HardSkillsArr1[5,7]=0;",
                        "for(i=0;i<6;i=i+1)HardSkillsArr1[i,7]=HardSkillsArr1[i,ShipSkill(Player(),i)];",
                        "ShipAddCustomShipInfo(Player(),'AMod_HardSkills_infos','NoShow');",
                        "str0=CT('AMod_HardSkills_text.SkillsText');",
                        "for(i=0;i<6;i=i+1)",
                        "\t{",
                        "\tif(ShipSkill(Player(),i)<6)int0=HardSkillsArr1[i,ShipSkill(Player(),i)+1];",
                        "\telse int0=HardSkillsArr1[i,ShipSkill(Player(),i)];",
                        "\tstr0=Format(str0,'CurExp'+i,HardSkillsArr1[i,7],'NeedExp'+i,int0);",
                        "\t}",
                        "InterfaceText('Ship','ModSkillsExp',str0);"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 305,
                    "Parent": -1,
                    "#": 14,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "if(!ShipIsTakeoff(Player())) {",
                        "  for(i=GalaxyEvents()-1;i>-1;i=i-1)",
                        "  \t{",
                        "  \tif(GalaxyEventDate(i)<CurTurn())break;",
                        "  \tif(HardSkillsArr2[3]<3  && ShipSkill(Player(),3)<6)",
                        "  \t\t{",
                        "  \t\tif(GalaxyEventType(i)=='PlayerBuysGoodsFromPlanet')",
                        "  \t\t\t{",
                        "  \t\t\tif(GalaxyEventData(i,2)>1999)",
                        "  \t\t\t\t{",
                        "  \t\t\t\tHardSkillsArr2[0]=HardSkillsArr2[0]+Rnd(30,70);",
                        "  \t\t\t\tHardSkillsArr2[3]=HardSkillsArr2[3]+1;",
                        "  \t\t\t\tHardSkillsArr0[6]=1;",
                        "  \t\t\t\t}",
                        "  \t\t\t}",
                        "  \t\tif(GalaxyEventType(i)=='PlayerBuysEquipment' && HardSkillsArr2[3]<3)",
                        "  \t\t\t{",
                        "  \t\t\tif(GalaxyEventData(i,1)>1999)",
                        "  \t\t\t\t{",
                        "  \t\t\t\tHardSkillsArr2[0]=HardSkillsArr2[0]+Rnd(20,40);",
                        "  \t\t\t\tHardSkillsArr2[3]=HardSkillsArr2[3]+1;",
                        "  \t\t\t\tHardSkillsArr0[6]=1;",
                        "  \t\t\t\t}",
                        "  \t\t\t}",
                        "  \t\tif(GalaxyEventType(i)=='PlayerSellsEquipment' && HardSkillsArr2[3]<3)",
                        "  \t\t\t{",
                        "  \t\t\tif(GalaxyEventData(i,1)>1999)",
                        "  \t\t\t\t{",
                        "  \t\t\t\tHardSkillsArr2[0]=HardSkillsArr2[0]+Rnd(20,40);",
                        "  \t\t\t\tHardSkillsArr2[3]=HardSkillsArr2[3]+1;",
                        "  \t\t\t\tHardSkillsArr0[6]=1;",
                        "  \t\t\t\t}",
                        "  \t\t\t}",
                        "  \t\t}",
                        "  \tif(HardSkillsArr2[4]<3 && ShipSkill(Player(),4)<6)",
                        "  \t\t{",
                        "  \t\tif(GalaxyEventType(i)=='PlayerFinishesQuest')",
                        "  \t\t\t{",
                        "  \t\t\tHardSkillsArr2[1]=HardSkillsArr2[1]+GalaxyEventData(i,3);",
                        "  \t\t\tHardSkillsArr2[4]=HardSkillsArr2[4]+1;",
                        "  \t\t\tHardSkillsArr0[6]=1;",
                        "  \t\t\t}",
                        "  \t\tif(GalaxyEventType(i)=='PlayerFinishesPlanetaryBattle' && HardSkillsArr2[4]<3)",
                        "  \t\t\t{",
                        "  \t\t\tHardSkillsArr2[1]=HardSkillsArr2[1]+GalaxyEventData(i,2);",
                        "  \t\t\tHardSkillsArr2[4]=HardSkillsArr2[4]+1;",
                        "  \t\t\tHardSkillsArr0[6]=1;",
                        "  \t\t\t}",
                        "  \t\t}",
                        "  \tif(HardSkillsArr2[5]<3 && ShipSkill(Player(),5)<6)",
                        "  \t\t{",
                        "  \t\tif(GalaxyEventType(i)=='PlayerTalkedShipIntoAttacking')",
                        "  \t\t\t{",
                        "  \t\t\tHardSkillsArr2[2]=HardSkillsArr2[2]+Rnd(50,125);",
                        "  \t\t\tHardSkillsArr2[5]=HardSkillsArr2[5]+1;",
                        "  \t\t\tHardSkillsArr0[6]=1;",
                        "  \t\t\t}",
                        "  \t\tif(GalaxyEventType(i)=='PlayerGotExpFromPartner' && HardSkillsArr2[5]<3)",
                        "  \t\t\t{",
                        "  \t\t\tHardSkillsArr2[2]=HardSkillsArr2[2]+GalaxyEventData(i,4);",
                        "  \t\t\tHardSkillsArr2[5]=HardSkillsArr2[5]+1;",
                        "  \t\t\tHardSkillsArr0[6]=1;",
                        "  \t\t\t}",
                        "  \t\t}",
                        "  \t}",
                        "  if(CurrentMods('Universe\\UniQuestRework'))",
                        "  {",
                        "      if(ArrayDim(g_UQR_EvQuest) >= 5 && ArrayDim(g_UQR_EvPB) >= 4)",
                        "  \t{",
                        "  \tif(HardSkillsArr2[4]<3 && ShipSkill(Player(),4)<6 && g_UQR_EvQuest[4]==CurTurn())",
                        "  \t\t{",
                        "  \t\tHardSkillsArr2[1]=HardSkillsArr2[1]+g_UQR_EvQuest[3];",
                        "  \t\tHardSkillsArr2[4]=HardSkillsArr2[4]+1;",
                        "  \t\tHardSkillsArr0[6]=1;",
                        "  \t\t}",
                        "  \tif(HardSkillsArr2[4]<3 && ShipSkill(Player(),4)<6 && g_UQR_EvPB[3]==CurTurn())",
                        "  \t\t{",
                        "  \t\tHardSkillsArr2[1]=HardSkillsArr2[1]+g_UQR_EvPB[2];",
                        "  \t\tHardSkillsArr2[4]=HardSkillsArr2[4]+1;",
                        "  \t\tHardSkillsArr0[6]=1;",
                        "  \t\t}",
                        "  \t}",
                        "  }",
                        "  if(HardSkillsArr0[6]==1) {",
                        "    HardSkillsArr0[6]=0;",
                        "    for(i=0;i<3;i=i+1)",
                        "    \t{",
                        "    \tif(HardSkillsArr0[i+3]>0)",
                        "    \t\t{",
                        "    \t\tHardSkillsArr1[i,7]=HardSkillsArr1[i,7]+HardSkillsArr0[i];",
                        "    \t\tHardSkillsArr0[i]=0;",
                        "    \t\tHardSkillsArr0[i+3]=0;",
                        "    \t\t}",
                        "    \tif(HardSkillsArr2[i+3]>0)",
                        "    \t\t{",
                        "    \t\tHardSkillsArr1[i+3,7]=HardSkillsArr1[i+3,7]+HardSkillsArr2[i];",
                        "    \t\tHardSkillsArr2[i]=0;",
                        "    \t\tHardSkillsArr2[i+3]=0;",
                        "    \t\t}",
                        "    \t}",
                        "    str0='';",
                        "    for(i=0;i<6;i=i+1)",
                        "    \t{",
                        "    \tif(ShipSkill(Player(),i)<6)",
                        "    \t\t{",
                        "    \t\tif(i==3)int0=GetShipExpByType(Player(),4);",
                        "    \t\telse int0=0;",
                        "    \t\tif(HardSkillsArr1[i,7]+int0>=HardSkillsArr1[i,ShipSkill(Player(),i)+1])",
                        "    \t\t\t{",
                        "    \t\t\tShipSkill(Player(),i,ShipSkill(Player(),i)+1);",
                        "    \t\t\tif(ShipSkill(Player(),i)>5)HardSkillsArr1[i,7]=HardSkillsArr1[i,6];",
                        "    \t\t\tstr0=str0+CT('AMod_HardSkills_text.'+i);",
                        "    \t\t\t}",
                        "    \t\t}",
                        "    \t}",
                        "    if(str0!='')",
                        "    \t{",
                        "    \tSound('Sound.QuestOk');",
                        "    \tCustomEther('SkillUp',7,'hardmod_skill_up',str0);",
                        "    \t}",
                        "    str0=CT('AMod_HardSkills_text.SkillsText');",
                        "    for(i=0;i<6;i=i+1)",
                        "    \t{",
                        "    \tif(ShipSkill(Player(),i)<6)int0=HardSkillsArr1[i,ShipSkill(Player(),i)+1];",
                        "    \telse int0=HardSkillsArr1[i,ShipSkill(Player(),i)];",
                        "    \tstr0=Format(str0,'CurExp'+i,HardSkillsArr1[i,7],'NeedExp'+i,int0);",
                        "    \t}",
                        "    InterfaceText('Ship','ModSkillsExp',str0);",
                        "  }",
                        "}"
                    ]
                }
            ],
