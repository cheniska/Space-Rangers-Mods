                        "if(!RAMaloc) {",
                        "    int raKit = 1;",
                        "    dword raEq = ShipEqInSlot(Player(),t_Hull);",
                        "    if(!raEq) raKit = 0;",
                        "    else if(ItemOwner(raEq) != Maloc) raKit = 0;",
                        "    raEq = ShipEqInSlot(Player(),t_Engine);",
                        "    if(!raEq) raKit = 0;",
                        "    else if(ItemOwner(raEq) != Maloc) raKit = 0;",
                        "    raEq = ShipEqInSlot(Player(),t_FuelTanks);",
                        "    if(!raEq) raKit = 0;",
                        "    else if(ItemOwner(raEq) != Maloc) raKit = 0;",
                        "    raEq = ShipEqInSlot(Player(),t_Radar);",
                        "    if(!raEq) raKit = 0;",
                        "    else if(ItemOwner(raEq) != Maloc) raKit = 0;",
                        "    raEq = ShipEqInSlot(Player(),t_CargoHook);",
                        "    if(!raEq) raKit = 0;",
                        "    else if(ItemOwner(raEq) != Maloc) raKit = 0;",
                        "    for(int raW = 1; raW <= 5; raW = raW + 1) {",
                        "        raEq = ShipEqInSlot(Player(),t_Weapon1,raW);",
                        "        if(!raEq) raKit = 0;",
                        "        else {",
                        "            if(ItemOwner(raEq) != Maloc) raKit = 0;",
                        "            if(ItemType(raEq) != t_Weapon2) raKit = 0;",
                        "        }",
                        "    }",
                        "    if(ShipEqInSlot(Player(),t_Scaner)) raKit = 0;",
                        "    if(ShipEqInSlot(Player(),t_RepairRobot)) raKit = 0;",
                        "    if(ShipEqInSlot(Player(),t_DefGenerator)) raKit = 0;",
                        "    for(int raA = 1; raA <= 4; raA = raA + 1) {",
                        "        if(ShipEqInSlot(Player(),t_Artefact,raA)) raKit = 0;",
                        "    }",
                        "    if(raKit) RAMaloc = 1;",
                        "}",
                        "if(!RAMillionaire && ShipMoney(Player()) >= 100000000) RAMillionaire = 1;",
                        "int raNeedHlam = !RAHlamModules && CurrentMods('Reflection\\RefHlamMM');",
                        "int raNeedRem = !RAUnlocked[42] && (CurrentMods('OtherMods\\SR1Equipment') || CurrentMods('Kotyanka\\Cat_SR1Equipment'));",
                        "if(!RADominatorSet || !RAKlissanSet || raNeedRem || raNeedHlam) {",
                        "    int raDomOk = !RADominatorSet;",
                        "    int raKliOk = !RAKlissanSet;",
                        "    int raRemOk = raNeedRem;",
                        "    int raHlamOk = raNeedHlam;",
                        "    int raHlamCount = 0;",
                        "    dword raSetItem = 0;",
                        "    str raFaction = '';",
                        "    if(raDomOk || raKliOk || raRemOk || raHlamOk) {",
                        "        for(int raEqType = t_Hull; raEqType <= t_DefGenerator; raEqType = raEqType + 1) {",
                        "            raSetItem = ShipEqInSlot(Player(),raEqType);",
                        "            if(!raSetItem) { raDomOk = 0; raKliOk = 0; raRemOk = 0; continue; }",
                        "            if(raHlamOk) {",
                        "                raHlamCount = raHlamCount + 1;",
                        "                if(substr(BonusNumInCfg(EqModule(raSetItem)),0,10) != 'RefMM_Hlam') raHlamOk = 0;",
                        "            }",
                        "            if(raDomOk || raKliOk) {",
                        "                raFaction = EqCustomFaction(raSetItem);",
                        "                if(raFaction != 'Klissan') raKliOk = 0;",
                        "                if(ItemOwner(raSetItem) != Kling || raFaction == 'Klissan') raDomOk = 0;",
                        "            }",
                        "            if(raRemOk) {",
                        "                if(raEqType == t_Hull) {",
                        "                    str raHullBonus = BonusNumInCfg(EqSpecial(raSetItem));",
                        "                    if(findsubstr(raHullBonus,'SR1Equipment_') != 0 || findsubstr(raHullBonus,'Hull') < 0) raRemOk = 0;",
                        "                } else {",
                        "                    str raRemExpected = '';",
                        "                    if(raEqType == t_FuelTanks) raRemExpected = 'SR1Equipment_RemFuelTank';",
                        "                    else if(raEqType == t_Engine) raRemExpected = 'SR1Equipment_RemEngine';",
                        "                    else if(raEqType == t_Radar) raRemExpected = 'SR1Equipment_RemRadar';",
                        "                    else if(raEqType == t_Scaner) raRemExpected = 'SR1Equipment_RemScaner';",
                        "                    else if(raEqType == t_RepairRobot) raRemExpected = 'SR1Equipment_RemDroid';",
                        "                    else if(raEqType == t_CargoHook) raRemExpected = 'SR1Equipment_RemHook';",
                        "                    else if(raEqType == t_DefGenerator) raRemExpected = 'SR1Equipment_RemDefGenerator';",
                        "                    if(findsubstr(BonusNumInCfg(EqModule(raSetItem)),raRemExpected) != 0) raRemOk = 0;",
                        "                }",
                        "            }",
                        "            if(!raDomOk && !raKliOk && !raRemOk && !raHlamOk) break;",
                        "        }",
                        "        if(raDomOk || raKliOk || raHlamOk) {",
                        "            int raWeaponSlots = ShipSlots(Player(),1);",
                        "            if(raWeaponSlots < 1 || raWeaponSlots > 5) { raDomOk = 0; raKliOk = 0; }",
                        "            if(raDomOk || raKliOk || raHlamOk) {",
                        "                for(int raSetW = 1; raSetW <= raWeaponSlots; raSetW = raSetW + 1) {",
                        "                    raSetItem = ShipEqInSlot(Player(),t_Weapon1,raSetW);",
                        "                    if(!raSetItem) { raDomOk = 0; raKliOk = 0; continue; }",
                        "                    if(raHlamOk) {",
                        "                        raHlamCount = raHlamCount + 1;",
