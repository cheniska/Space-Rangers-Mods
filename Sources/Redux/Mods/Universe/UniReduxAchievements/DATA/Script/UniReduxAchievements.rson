                        "function g_ReduxAchRecordRattorMethod(int raMethod) {",
                        "    g_SyncAchievements();",
                        "    if(RAResetLock || RAUnlocked[74] || raMethod < 1 || raMethod > 5) exit;",
                        "    if(raMethod == 1 && !RARattorMethod1) {",
                        "        RARattorMethod1 = 1;",
                        "        g_SaveAchievement('RARattorMethod1',1);",
                        "    }",
                        "    if(raMethod == 2 && !RARattorMethod2) {",
                        "        RARattorMethod2 = 1;",
                        "        g_SaveAchievement('RARattorMethod2',1);",
                        "    }",
                        "    if(raMethod == 3 && !RARattorMethod3) {",
                        "        RARattorMethod3 = 1;",
                        "        g_SaveAchievement('RARattorMethod3',1);",
                        "    }",
                        "    if(raMethod == 4 && !RARattorMethod4) {",
                        "        RARattorMethod4 = 1;",
                        "        g_SaveAchievement('RARattorMethod4',1);",
                        "    }",
                        "    if(raMethod == 5 && !RARattorMethod5) {",
                        "        RARattorMethod5 = 1;",
                        "        g_SaveAchievement('RARattorMethod5',1);",
                        "    }",
                        "    RARattorMethods = min(5, RARattorMethod1 + RARattorMethod2 + RARattorMethod3 + RARattorMethod4 + RARattorMethod5);",
                        "    if(RARattorMethods >= 5) g_ReduxAchUnlock74();",
                        "}",
                        "function g_ReduxAchRecordSuperdom(int raSeries, int raSubtype) {",
                        "    g_SyncAchievements();",
                        "    if(RAResetLock || RAUnlocked[75] || raSeries < 0 || raSeries > 2 || raSubtype < 1 || raSubtype > 6) exit;",
                        "    int raIndex = raSeries * 6 + raSubtype - 1;",
                        "    if(RASuperdomSeen[raIndex]) exit;",
                        "    RASuperdomSeen[raIndex] = 1;",
                        "    RASuperdomCount = min(18, RASuperdomCount + 1);",
                        "    g_SaveAchievement('RASuperdom' + raIndex,1);",
                        "    if(RASuperdomCount >= 18) {",
                        "        RAUnlocked[75] = 1;",
                        "        g_SaveAchievement('A75',1);",
