                        "function g_SyncAchievements() {",
                        "    if(ArrayDim(RAUnlocked) < 89) {",
                        "        while(ArrayDim(RAUnlocked) < 89) { ArrayAdd(RAUnlocked,0); }",
                        "        RARevision = -1;",
                        "    }",
                        "    int raFileRevision = int(GetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt','Revision'));",
                        "    int raA24Epoch = int(GetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt','A24ResetEpoch'));",
                        "    if(RARevision != -1 && raFileRevision == RARevision && raA24Epoch <= RAA24ResetEpoch) exit;",
                        "    int raResetEpoch = int(GetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt','ResetEpoch'));",
                        "    if(raResetEpoch > RAResetEpoch) {",
                        "        RAResetEpoch = raResetEpoch;",
                        "        g_ClearAchievements();",
                        "        RAResetLock = 1;",
                        "    }",
                        "    if(raA24Epoch > RAA24ResetEpoch) {",
                        "        RAA24ResetEpoch = raA24Epoch;",
                        "        RAGalopedia = 0;",
                        "        RAUnlocked[24] = 0;",
                        "    }",
                        "    if(raFileRevision != RARevision || RARevision == -1) {",
                        "        RARevision = raFileRevision;",
