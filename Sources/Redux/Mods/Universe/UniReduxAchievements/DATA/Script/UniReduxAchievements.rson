                        "function g_AddSergoSavings(int paid, int divisor) {",
                        "    g_SyncAchievements();",
                        "    if(RAResetLock || RAUnlocked[31] || paid <= 0 || divisor <= 0) exit;",
                        "    int raSaved = max(0, round(1.0 * paid / divisor));",
                        "    if(raSaved <= 0) exit;",
                        "    RASergoSavings = min(10000000, RASergoSavings + raSaved);",
                        "    g_SaveAchievement('RASergoSavings',RASergoSavings);",
                        "    if(RASergoSavings >= 10000000) g_UnlockSergoSavings();",
                        "}",
