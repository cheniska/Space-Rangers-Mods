                        "function g_ReduxAchCheckCraftor() {",
                        "    if(RAResetLock || RAUnlocked[64]) exit;",
                        "    str raTrack = lowercase(MusicControls('GetCurFile'));",
                        "    if(findsubstr(raTrack,'craftor-') < 0) exit;",
                        "    if(!RACraftor0 && findsubstr(raTrack,'craftor-space_pirate') >= 0) {",
                        "        RACraftor0 = 1;",
                        "        g_SaveAchievement('RACraftor0',1);",
                        "    }",
                        "    if(!RACraftor1 && findsubstr(raTrack,'craftor-space_gangsters') >= 0) {",
                        "        RACraftor1 = 1;",
                        "        g_SaveAchievement('RACraftor1',1);",
                        "    }",
                        "    if(!RACraftor2 && findsubstr(raTrack,'craftor-space flight') >= 0) {",
                        "        RACraftor2 = 1;",
                        "        g_SaveAchievement('RACraftor2',1);",
                        "    }",
                        "    if(!RACraftor3 && findsubstr(raTrack,'craftor-nocturne') >= 0) {",
                        "        RACraftor3 = 1;",
                        "        g_SaveAchievement('RACraftor3',1);",
                        "    }",
                        "    if(!RACraftor4 && findsubstr(raTrack,'craftor-night_courage') >= 0) {",
                        "        RACraftor4 = 1;",
                        "        g_SaveAchievement('RACraftor4',1);",
                        "    }",
                        "    if(!RACraftor5 && findsubstr(raTrack,'craftor-march_of_renegades') >= 0) {",
                        "        RACraftor5 = 1;",
                        "        g_SaveAchievement('RACraftor5',1);",
                        "    }",
                        "    if(!RACraftor6 && findsubstr(raTrack,'craftor-hero_bambayka') >= 0) {",
                        "        RACraftor6 = 1;",
                        "        g_SaveAchievement('RACraftor6',1);",
                        "    }",
                        "    if(!RACraftor7 && findsubstr(raTrack,'craftor-dangerous_space') >= 0) {",
                        "        RACraftor7 = 1;",
                        "        g_SaveAchievement('RACraftor7',1);",
                        "    }",
                        "    if(!RACraftor8 && findsubstr(raTrack,'craftor-cosmic_wind') >= 0) {",
                        "        RACraftor8 = 1;",
                        "        g_SaveAchievement('RACraftor8',1);",
                        "    }",
                        "    if(!RACraftor9 && findsubstr(raTrack,'craftor-cosmic_romance') >= 0) {",
                        "        RACraftor9 = 1;",
                        "        g_SaveAchievement('RACraftor9',1);",
                        "    }",
                        "    if(!RACraftor10 && findsubstr(raTrack,'craftor-artifical_tactics') >= 0) {",
                        "        RACraftor10 = 1;",
                        "        g_SaveAchievement('RACraftor10',1);",
                        "    }",
                        "    RACraftorCount = min(11, RACraftor0 + RACraftor1 + RACraftor2 + RACraftor3 + RACraftor4 + RACraftor5 + RACraftor6 + RACraftor7 + RACraftor8 + RACraftor9 + RACraftor10);",
                        "    if(RACraftorCount >= 11) g_ReduxAchUnlock64();",
                        "}",
                        "function g_ReduxAchCheckMiniguns() {",
                        "    if(RAResetLock || RAUnlocked[65] || ShipCntWeapon(Player()) < 5) exit;",
                        "    int raMiniguns = 0;",
                        "    for(int raSlot = 1; raSlot <= ShipCntWeapon(Player()); raSlot = raSlot + 1) {",
                        "        dword raWeapon = ShipWeapon(Player(),raSlot);",
                        "        if(raWeapon) { if(CustomWeaponType(raWeapon) == 'Dom_minigun') raMiniguns = raMiniguns + 1; }",
                        "    }",
                        "    if(raMiniguns >= 5) g_ReduxAchUnlock65();",
                        "}",
                        "function g_ReduxAchCheckTravel() {",
                        "    if(RAResetLock || RAUnlocked[66]) exit;",
                        "    if(CurrentMods('Tweaks\\DevKit')) exit;",
                        "    dword raCurrentStar = ShipStar(Player());",
                        "    if(!raCurrentStar) exit;",
                        "    int raStar = Id(raCurrentStar);",
                        "    if(raStar < 1 || raStar > GalaxyStars() || raStar == RATravelLastStar) exit;",
                        "    RATravelLastStar = raStar;",
                        "    if(ArrayDim(RATravelVisits) != GalaxyStars()+1) RATravelVisits = newarray(GalaxyStars()+1);",
                        "    RATravelVisits[raStar] = CurTurn() + 1;",
                        "    RATravelCount = 0;",
                        "    for(int raI = 1; raI <= GalaxyStars(); raI = raI + 1) {",
                        "        if(RATravelVisits[raI] > 0 && RATravelVisits[raI] >= CurTurn() - 14 + 1) RATravelCount = RATravelCount + 1;",
                        "    }",
                        "    if(RATravelCount >= 7) g_ReduxAchUnlock66();",
                        "}",
