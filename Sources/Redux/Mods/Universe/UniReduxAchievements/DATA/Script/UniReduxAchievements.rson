                        "}",
                        "function g_ReduxAchUnlock87() { g_ReduxAchUnlockNew(87,'TRANCLUCATORS'); }",
                        "function g_ReduxAchUnlock88() { g_ReduxAchUnlockNew(88,'COMMANDOR'); }",
                        "function g_ReduxAchCheckBastion() {",
                        "    if(RAResetLock || RAUnlocked[83]) exit;",
                        "    if(!CurrentMods('Reflection\\RefExpHullsAbilities')) exit;",
                        "    if(ShipFindCustomShipInfoByType(Player(),'RefBastionFlag') < 0) exit;",
                        "    if(EqSpecial(ShipEqInSlot(Player(),t_Hull)) != FindBonusByNameInCfg('ExpHulls_Rock5') && EqSpecial(ShipEqInSlot(Player(),t_Hull)) != FindBonusByNameInCfg('351')) exit;",
                        "    for(int raI = 1; raI <= ShipSlots(Player(),2); raI = raI + 1) {",
                        "        dword raArt = ShipEqInSlot(Player(),t_Artefact,raI);",
                        "        if(!raArt || ItemIsBroken(raArt)) continue;",
                        "        str raArtName = EquipmentImageName(raArt);",
                        "        if(raArtName == 'Fa_Aeron_Art' || raArtName == 'Magnets_Art') { g_ReduxAchUnlock83(); exit; }",
                        "    }",
                        "}",
                        "function g_ReduxAchCheckIronDome() {",
                        "    if(RAResetLock || RAUnlocked[84]) exit;",
                        "    int raDome0 = 0; int raDome1 = 0; int raDome2 = 0; int raDome3 = 0;",
                        "    int raDome4 = 0; int raDome5 = 0; int raDome6 = 0; int raDome7 = 0;",
                        "    int raDome8 = 0; int raDome9 = 0; int raDome10 = 0; int raDome11 = 0;",
                        "    for(int raI = 1; raI <= ShipSlots(Player(),2); raI = raI + 1) {",
                        "        dword raArt = ShipEqInSlot(Player(),t_Artefact,raI);",
                        "        if(!raArt) continue;",
                        "        int raType = ItemType(raArt);",
                        "        str raName = EquipmentImageName(raArt);",
                        "        if(raType == t_ArtPDTurret) raDome0 = 1;",
                        "        if(raType == t_ArtEnergyDef || raName == 'ArtEnergyDefv2' || raName == 'ArtEnergyDefv3') raDome1 = 1;",
                        "        if(raType == t_ArtefactHull || raName == 'ArtHullv2' || raName == 'ArtHullv3') raDome2 = 1;",
                        "        if(raType == t_ArtMissileDef || raName == 'ArtMissileDefv2' || raName == 'ArtMissileDefv3') raDome3 = 1;",
                        "        if(raType == t_ArtefactDef || raName == 'ArtDefv2' || raName == 'ArtDefv3') raDome4 = 1;",
                        "        if(raType == t_ArtefactDroid || raName == 'ArtDroidv2' || raName == 'ArtDroidv3') raDome5 = 1;",
                        "        if(raName == 'Abaldo_Art') raDome6 = 1;",
                        "        if(raName == 'Eikaheaven_Art') raDome7 = 1;",
                        "        if(raName == 'Rasseivatel_Art') raDome8 = 1;",
                        "        if(raName == 'Stabilizator_Art') raDome9 = 1;",
                        "        if(raName == 'StealthCover_Art') raDome10 = 1;",
                        "        if(raName == 'HealingAura_Art') raDome11 = 1;",
                        "    }",
                        "    RAIronDomeCount = raDome0 + raDome1 + raDome2 + raDome3 + raDome4 + raDome5 + raDome6 + raDome7 + raDome8 + raDome9 + raDome10 + raDome11;",
                        "    if(RAIronDomeCount >= 12) g_ReduxAchUnlock84();",
                        "}",
                        "function g_ReduxAchUnlock82() {",
