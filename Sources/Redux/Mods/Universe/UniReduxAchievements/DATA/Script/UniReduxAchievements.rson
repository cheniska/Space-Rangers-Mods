                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 240,
                    "Pos.y": 160,
                    "Parent": -1,
                    "#": 7,
                    "Code.Type": "Turn",
                    "Code": [
                        "if(!RASeenInitialized) {",
                        "    RASeenRAStations = max(0, RAStations - int(GetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt','RAStations')));",
                        "    RASeenRAColonies = max(0, RAColonies - int(GetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt','RAColonies')));",
                        "    RASeenRAHasker = max(0, RAHasker - int(GetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt','RAHasker')));",
                        "    RASeenInitialized = 1;",
                        "}",
                        "g_SyncAchievements();",
                        "dword raTurnStar = ShipStar(Player());",
                        "int raTurnStarId = 0;",
                        "if(raTurnStar) raTurnStarId = Id(raTurnStar);",
                        "if(!RAUnlocked[78]) {",
                        "    dword raNokmEq = ShipEqInSlot(Player(),t_Engine);",
                        "    int raNokmValid = 0;",
                        "    if(CurrentMods('Revolution\\RevAcryn') && raNokmEq && raTurnStar) {",
                        "        int raNokmBonus = FindBonusByNameInCfg('RevAcryn_NOKM');",
                        "        if(raNokmBonus >= 0 && EqSpecial(raNokmEq) == raNokmBonus && StarOwner(raTurnStar) == 0) raNokmValid = 1;",
                        "    }",
                        "    if(raNokmValid) {",
                        "        if(RANokmEngine != Id(raNokmEq) || RANokmStar != raTurnStarId) { RANokmEngine = Id(raNokmEq); RANokmStar = raTurnStarId; RANokmKills = 0; }",
                        "    } else { RANokmEngine = 0; RANokmStar = 0; RANokmKills = 0; }",
                        "}",
                        "if(!RAUnlocked[79]) {",
                        "    if(!raTurnStar || HullDamage(Player()) < 80 || GetShipPlanet(Player()) || GetShipRuins(Player()) || !ShipInNormalSpace(Player())) { RAFragileStar = 0; RAFragileKills = 0; }",
                        "    else if(RAFragileStar != raTurnStarId) { RAFragileStar = raTurnStarId; RAFragileKills = 0; }",
                        "}",
                        "if(!RAResetLock) {",
                        "int raOld01 = RATranc >= 1;",
                        "int raOld02 = RAStations >= 10;",
                        "int raOld03 = RAThreat >= 1;",
                        "int raOld04 = RANova >= 1;",
                        "int raOld05 = RABosses >= 1;",
                        "int raOld06 = RAAllies >= 1;",
                        "int raOld07 = RAColonies >= 10;",
                        "int raOld08 = RAHasker >= 1000000;",
                        "int raOld09 = RABoard >= 1;",
                        "int raOld10 = RAArmor >= 1;",
                        "int raOld11 = RABlizzard >= 1;",
                        "int raOld12 = RADebt >= 1;",
                        "int raOld13 = RAKlissan >= 500;",
                        "int raOld14 = RATraitors >= 50;",
                        "int raOld15 = RADreads >= 10;",
                        "int raOld16 = RAGalleons >= 10;",
                        "int raOld17 = RAPMC >= 1;",
                        "int raOld18 = RAFever >= 1;",
                        "int raOld19 = RADiseases >= 9;",
                        "int raOld20 = RAStims >= 12;",
                        "int raOld21 = RAQuests >= 10 && RAPB >= 10;",
                        "int raOld22 = RAKeller >= 1;",
                        "int raOld23 = RARansom >= 100;",
                        "int raOld24 = RAGalopedia >= 1;",
                        "int raOld25 = RAMaloc >= 1;",
                        "int raOld26 = RADominatorSet >= 1;",
                        "int raOld27 = RAKlissanSet >= 1;",
                        "int raOld28 = RAMillionaire >= 1;",
                        "int raOld29 = RAHlamModules >= 1;",
                        "int raN = GalaxyEvents();",
                        "str raNewest = '';",
                        "if(raN > 0) {",
                        "    int raLast = raN - 1;",
                        "    raNewest = '' + GalaxyEventDate(raLast) + ':' + GalaxyEventType(raLast);",
                        "    if(GalaxyEventData(raLast) > 0) raNewest = raNewest + ':' + GalaxyEventData(raLast,0);",
                        "    if(GalaxyEventData(raLast) > 1) raNewest = raNewest + ':' + GalaxyEventData(raLast,1);",
                        "    if(GalaxyEventData(raLast) > 2) raNewest = raNewest + ':' + GalaxyEventData(raLast,2);",
                        "    for(int raI = raLast; raI >= 0; raI = raI - 1) {",
                        "        if(GalaxyEventDate(raI) < CurTurn() - 1) break;",
                        "        str raType = GalaxyEventType(raI);",
                        "        str raSig = '' + GalaxyEventDate(raI) + ':' + raType;",
                        "        if(GalaxyEventData(raI) > 0) raSig = raSig + ':' + GalaxyEventData(raI,0);",
                        "        if(GalaxyEventData(raI) > 1) raSig = raSig + ':' + GalaxyEventData(raI,1);",
                        "        if(GalaxyEventData(raI) > 2) raSig = raSig + ':' + GalaxyEventData(raI,2);",
                        "        if(raSig == RALastEvent) break;",
                        "        if(raType == 'PlayerFinishesQuest') {",
                        "            if(GalaxyEventData(raI,0) == 2 && RAQuests < 10) RAQuests = RAQuests + 1;",
                        "            if(GalaxyEventData(raI,0) == 1 && GalaxyEventData(raI,2) > 0) g_AddHitmanReward(GalaxyEventData(raI,2));",
                        "        }",
                        "        if(raType == 'PlayerFinishesPlanetaryBattle') {",
                        "            if(RAPB < 10) RAPB = RAPB + 1;",
                        "        }",
                        "        if(raType == 'PlayerLiberatesSystem' && !RAUnlocked[80] && GalaxyEventData(raI,3) > 0 && RAShotsStar == GalaxyEventData(raI,0) && RAShotsInStar == 1) g_ReduxAchUnlock80();",
                        "        if(raType == 'PlayerLiberatesSystem' && !RAUnlocked[53]) {",
                        "            g_RecordSystemLiberation(GalaxyEventData(raI,0));",
                        "        }",
                        "        if(raType == 'PlayerSellsEquipment' && RACisterns < 1000) {",
                        "            if(GalaxyEventData(raI,0) == t_Cistern && GalaxyEventData(raI,4) == 1) {",
                        "                dword raShop = IdToShip(GalaxyEventData(raI,5));",
                        "                if(raShop && raShop != 4294967295) {",
                        "                    if(ShipTypeN(raShop) == t_RC) g_RecordCisternSale();",
                        "                }",
                        "            }",
                        "        }",
                        "        if(raType == 'PlayerKillsShip') {",
                        "            if(!RAUnlocked[78] && RANokmEngine && RANokmStar == GalaxyEventData(raI,1) && (GalaxyEventData(raI,0) == t_Kling || GalaxyEventData(raI,0) == t_Pirate)) {",
                        "                RANokmKills = min(25, RANokmKills + 1);",
                        "                if(RANokmKills >= 25) g_ReduxAchUnlock78();",
                        "            }",
                        "            if(!RAUnlocked[79] && RAFragileStar == GalaxyEventData(raI,1) && RAFragileStar > 0) {",
                        "                RAFragileKills = min(10, RAFragileKills + 1);",
                        "                if(RAFragileKills >= 10) g_ReduxAchUnlock79();",
                        "            }",
                        "            str raShipType = GalaxyEventsTextData(raI,2);",
                        "            if(RARansom < 100) {",
                        "                int raVictimId = GalaxyEventData(raI,2);",
                        "                if(raVictimId > 0) {",
                        "                    for(int raJ = raI - 1; raJ >= 0; raJ = raJ - 1) {",
                        "                        if(GalaxyEventDate(raJ) < GalaxyEventDate(raI) - 1) break;",
                        "                        if(GalaxyEventType(raJ) == 'PlayerExtortsMoney') {",
                        "                            if(GalaxyEventData(raJ,3) == raVictimId) { RARansom = RARansom + 1; break; }",
                        "                        }",
                        "                    }",
                        "                }",
                        "            }",
                        "            if(findsubstr(raShipType,'Klissan') == 0) { if(RAKlissan < 500) RAKlissan = RAKlissan + 1; }",
                        "            if(raShipType == 'RangerPirate' || raShipType == 'RangerPirateExplorer') { if(RATraitors < 50) RATraitors = RATraitors + 1; }",
                        "            if(raShipType == 'Dreadnought') { if(RADreads < 10) RADreads = RADreads + 1; }",
                        "            if(raShipType == 'PirateGalleon') { if(RAGalleons < 10) RAGalleons = RAGalleons + 1; }",
                        "        }",
                        "    }",
                        "    RALastEvent = raNewest;",
                        "}",
                        "if(!RAUnlocked[80] && RAShotsStar != raTurnStarId) { RAShotsStar = raTurnStarId; RAShotsInStar = 0; }",
                        "if(!RAAllies && (ShipPartners(Player()) >= 6 || PlayerPirates() >= 6)) {",
                        "    if(CurrentMods('ShusRangers\\ShuMercsHQ') && IsScriptActive('Mod_ShuMercsHQ')) {",
                        "        if(RunFunctionFromScript('Mod_ShuMercsHQ','ReduxAchStrikeGroupFollowing')) {",
                        "            if(CurrentMods('Evolution\\EvoTranc') && IsScriptActive('Mod_EvoTranc')) {",
                        "                if(RunFunctionFromScript('Mod_EvoTranc','ReduxAchFullActiveTrancCount') >= 6) RAAllies = 1;",
                        "            }",
                        "        }",
                        "    }",
                        "}",
                        "if(!RAKeller) {",
                        "    RAKellerKills = min(70, ShipStatistic(Player(),7) + ShipStatistic(Player(),8));",
                        "    if(RAKellerCandidate > 0 && CurTurn() <= RAKellerCandidate + 1 && DomiksDefeated(1) == 1) RAKeller = 1;",
                        "    if(DomiksDefeated(1) == 0 && ShipInHyperSpace(Player()) && GalaxyDiffLevels(6) >= 500 && RAKellerKills >= 70) RAKellerCandidate = CurTurn();",
                        "}",
                        "if(RAHasker < 1000000) {",
                        "    if(CurrentMods('Expansion\\ExpArts')) {",
                        "        if(IsScriptActive('Mod_ExpArts')) {",
                        "            int raSourceRAHasker = min(1000000, int(GetValueFromScript('Mod_ExpArts','ReduxAchHasker')));",
                        "            if(raSourceRAHasker < RASeenRAHasker) RASeenRAHasker = raSourceRAHasker;",
                        "            if(raSourceRAHasker > RASeenRAHasker) {",
                        "                RAHasker = min(1000000, RAHasker + raSourceRAHasker - RASeenRAHasker);",
                        "                RASeenRAHasker = raSourceRAHasker;",
                        "            }",
