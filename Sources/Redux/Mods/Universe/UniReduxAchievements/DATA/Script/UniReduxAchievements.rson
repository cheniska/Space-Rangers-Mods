                        "function g_SaveAchievement(str raKey, int raValue) {",
                        "    SetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt',raKey,'' + raValue);",
                        "    RARevision = RARevision + 1;",
                        "    SetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt','Revision','' + RARevision);",
                        "}",
