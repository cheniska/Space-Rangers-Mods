                        "                        if(ItemOwner(raSetItem) != Kling || raFaction == 'Klissan') raDomOk = 0;",
                        "                    }",
                        "                    if(!raDomOk && !raKliOk && !raHlamOk) break;",
                        "                }",
                        "            }",
                        "        }",
                        "        if(raDomOk) RADominatorSet = 1;",
                        "        if(raKliOk) RAKlissanSet = 1;",
