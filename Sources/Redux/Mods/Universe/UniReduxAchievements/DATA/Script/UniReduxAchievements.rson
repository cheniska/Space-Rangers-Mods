                        "function g_ReduxAchCountDistinct(str raKey, int raId, int raObjectId) {",
                        "    g_SyncAchievements();",
                        "    result = -1;",
                        "    if(RAResetLock || RAUnlocked[raId]) exit;",
                        "    str raToken = '' + GetObjectGenerationSeed(GalaxyPtr()) + ':' + raObjectId;",
                        "    str raHistory = GetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt',raKey);",
                        "    if(findsubstr(',' + raHistory + ',', ',' + raToken + ',') >= 0) exit;",
                        "    if(raHistory != '') raHistory = raHistory + ',';",
                        "    raHistory = raHistory + raToken;",
                        "    SetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt',raKey,raHistory);",
                        "    RARevision = RARevision + 1;",
                        "    SetParFromTxt('SpaceRangersHD/UniReduxAchievements.txt','Revision','' + RARevision);",
                        "    result = min(100, ParsCountFromString(raHistory,','));",
                        "}",
                        "function g_ReduxAchRecordTreasure(int raItemId) {",
                        "    int raCount = g_ReduxAchCountDistinct('RATreasureFindKeys',85,raItemId);",
                        "    if(raCount >= 0) RATreasureFinds = raCount;",
                        "    if(RATreasureFinds >= 100) g_ReduxAchUnlockNew(85,'EXPLORER');",
                        "}",
                        "function g_ReduxAchNeedsTreasure() {",
