                        "        RASuperdomCount = min(18, RASuperdomSeen[0] + RASuperdomSeen[1] + RASuperdomSeen[2] + RASuperdomSeen[3] + RASuperdomSeen[4] + RASuperdomSeen[5] + RASuperdomSeen[6] + RASuperdomSeen[7] + RASuperdomSeen[8] + RASuperdomSeen[9] + RASuperdomSeen[10] + RASuperdomSeen[11] + RASuperdomSeen[12] + RASuperdomSeen[13] + RASuperdomSeen[14] + RASuperdomSeen[15] + RASuperdomSeen[16] + RASuperdomSeen[17]);",
