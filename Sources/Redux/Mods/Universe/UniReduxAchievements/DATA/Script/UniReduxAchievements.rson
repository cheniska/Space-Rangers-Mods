                        "    for(int raWeaponI = 0; raWeaponI < raWeaponItems; raWeaponI = raWeaponI + 1) {",
                        "        dword raWeaponItem = ShipItems(Player(),raWeaponI);",
                        "        if(ItemType(raWeaponItem) < t_Weapon1 || ItemType(raWeaponItem) > t_CustomWeapon) continue;",
                        "        str raWeaponBonus = BonusNumInCfg(EqSpecial(raWeaponItem));",
                        "        if(!RABossWeaponBlazer && raWeaponBonus == 'ShuDomiks_BlazerMassacre') {",
                        "            RABossWeaponBlazer = 1;",
                        "            g_SaveAchievement('RABossWeaponBlazer',1);",
                        "        }",
                        "        if(!RABossWeaponKeller && raWeaponBonus == 'ShuDomiks_KellerJavelin') {",
                        "            RABossWeaponKeller = 1;",
                        "            g_SaveAchievement('RABossWeaponKeller',1);",
                        "        }",
                        "        if(!RABossWeaponTerron && raWeaponBonus == 'ShuDomiks_TerronRailgun') {",
                        "            RABossWeaponTerron = 1;",
                        "            g_SaveAchievement('RABossWeaponTerron',1);",
                        "        }",
                        "        if(!RABossWeaponMachpella && raWeaponBonus == 'ShuKlissan_MachpellaHellWave') {",
                        "            RABossWeaponMachpella = 1;",
                        "            g_SaveAchievement('RABossWeaponMachpella',1);",
                        "        }",
                        "        if(RABossWeaponBlazer && RABossWeaponKeller && RABossWeaponTerron && RABossWeaponMachpella) break;",
                        "    }",
                        "    if(!(RABossWeaponBlazer && RABossWeaponKeller && RABossWeaponTerron && RABossWeaponMachpella)) {",
                        "        int raStorageItems = StorageItems();",
                        "        for(int raStoreI = 0; raStoreI < raStorageItems; raStoreI = raStoreI + 1) {",
                        "            dword raStoreItem = StorageItems(raStoreI);",
                        "            if(ItemType(raStoreItem) < t_Weapon1 || ItemType(raStoreItem) > t_CustomWeapon) continue;",
                        "            str raStoreBonus = BonusNumInCfg(EqSpecial(raStoreItem));",
                        "            if(!RABossWeaponBlazer && raStoreBonus == 'ShuDomiks_BlazerMassacre') {",
                        "                RABossWeaponBlazer = 1;",
                        "                g_SaveAchievement('RABossWeaponBlazer',1);",
                        "            }",
                        "            if(!RABossWeaponKeller && raStoreBonus == 'ShuDomiks_KellerJavelin') {",
                        "                RABossWeaponKeller = 1;",
                        "                g_SaveAchievement('RABossWeaponKeller',1);",
                        "            }",
                        "            if(!RABossWeaponTerron && raStoreBonus == 'ShuDomiks_TerronRailgun') {",
                        "                RABossWeaponTerron = 1;",
                        "                g_SaveAchievement('RABossWeaponTerron',1);",
                        "            }",
                        "            if(!RABossWeaponMachpella && raStoreBonus == 'ShuKlissan_MachpellaHellWave') {",
                        "                RABossWeaponMachpella = 1;",
                        "                g_SaveAchievement('RABossWeaponMachpella',1);",
                        "            }",
                        "            if(RABossWeaponBlazer && RABossWeaponKeller && RABossWeaponTerron && RABossWeaponMachpella) break;",
                        "        }",
                        "    }",
                        "    RABossWeaponCount = RABossWeaponBlazer + RABossWeaponKeller + RABossWeaponTerron + RABossWeaponMachpella;",
