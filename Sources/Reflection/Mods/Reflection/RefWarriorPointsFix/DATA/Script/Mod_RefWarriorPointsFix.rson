            "Operations": 
            [
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -50,
                    "Pos.y": -90,
                    "Parent": -1,
                    "#": 5,
                    "Code.Type": "Global",
                    "Code": 
                    [
                        "if(!GCntRun(GScriptName)) GRun();"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": -10,
                    "Pos.y": -90,
                    "Parent": -1,
                    "#": 6,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "if(!ShipIsTakeoff(Player())) {",
                        "    if(lastProcessedTurn != CurTurn()) {",
                        "        j = 0;",
                        "        for(i=GalaxyEvents()-1; i>=0; i=i-1) {",
                        "            if(GalaxyEventDate(i) < CurTurn()) break;",
                        "            if(GalaxyEventType(i)=='PlayerChangesSide') {",
                        "                pointsReserved = 0;",
                        "                break;",
                        "            }",
                        "            if(GalaxyEventType(i)=='PlayerKillsShip' || (GalaxyEventType(i)=='PlayerTranclucatorKillsShip' && (GalaxyEventData(i,0)==7 || GalaxyEventData(i,0)==12))) {",
                        "                if(!ShipOnSidePirateClan(Player())) {",
                        "                    if(GalaxyEventData(i,0) == 7) {",
                        "                        j = j + 9;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == 12) {",
                        "                        j = j + 15;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == t_Kling) {",
                        "                        if(GalaxyEventData(i,5) == 0) j = j + 250;",
                        "                        else if(GalaxyEventData(i,5) == 1) j = j + 48;",
                        "                        else if(GalaxyEventData(i,5) == 2) j = j + 24;",
                        "                        else if(GalaxyEventData(i,5) == 3) j = j + 12;",
                        "                        else if(GalaxyEventData(i,5) == 4) j = j + 6;",
                        "                        else if(GalaxyEventData(i,5) == 5) j = j + 3;",
                        "                        else if(GalaxyEventData(i,5) == 6) j = j + 60;",
                        "                        else if(GalaxyEventData(i,5) == 7) j = j + 1;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == t_Pirate) {",
                        "                        j = j + 10;",
                        "                    }",
                        "                }",
                        "                else {",
                        "                    if(GalaxyEventData(i,0) == t_Warrior) {",
                        "                        if(GalaxyEventData(i,5)) j = j + 60;",
                        "                        else j = j + 16;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == t_Transport) {",
                        "                        j = j + 8;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == 6) {",
                        "                        j = j + 32;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == 8) {",
                        "                        j = j + 32;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == 9) {",
                        "                        j = j + 24;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == 10) {",
                        "                        j = j + 24;",
                        "                    }",
                        "                    else if(GalaxyEventData(i,0) == t_Kling) {",
                        "                        if(GalaxyEventData(i,5) == 1) j = j + 16;",
                        "                        else if(GalaxyEventData(i,5) == 2) j = j + 8;",
                        "                        else if(GalaxyEventData(i,5) == 3) j = j + 4;",
                        "                        else if(GalaxyEventData(i,5) == 4) j = j + 2;",
                        "                        else if(GalaxyEventData(i,5) == 5) j = j + 1;",
                        "                        else if(GalaxyEventData(i,5) == 6) j = j + 24;",
                        "                        else if(GalaxyEventData(i,5) == 7) j = j + 1;",
                        "                    }",
                        "                }",
                        "            }",
                        "        }",
                        "        if(!ShipOnSidePirateClan(Player())) {",
                        "            if(ShipRank(Player()) < 7 && ShipRankPoints(Player()) >= ShipNextRankPoints(Player())) {",
                        "                k = 0;",
                        "                if(lastRankPoints >= 0) {",
                        "                    k = ShipNextRankPoints(Player()) - lastRankPoints;",
                        "                    if(k < 0) k = 0;",
                        "                    if(j > k) k = j - k;",
                        "                    else k = 0;",
                        "                }",
                        "                if(ShipRankPoints(Player()) - ShipNextRankPoints(Player()) > k) k = ShipRankPoints(Player()) - ShipNextRankPoints(Player());",
                        "                pointsReserved = pointsReserved + k;",
                        "                if(ShipRankPoints(Player()) > ShipNextRankPoints(Player())) ShipRankPoints(Player(),ShipNextRankPoints(Player()));",
                        "            }",
                        "        }",
                        "        else {",
                        "            if(GetShipPirateRank(Player()) < 7 && ShipPirateRankPoints(Player()) >= ShipNextPirateRankPoints(Player())) {",
                        "                k = 0;",
                        "                if(lastPirateRankPoints >= 0) {",
                        "                    k = ShipNextPirateRankPoints(Player()) - lastPirateRankPoints;",
                        "                    if(k < 0) k = 0;",
                        "                    if(j > k) k = j - k;",
                        "                    else k = 0;",
                        "                }",
                        "                if(ShipPirateRankPoints(Player()) - ShipNextPirateRankPoints(Player()) > k) k = ShipPirateRankPoints(Player()) - ShipNextPirateRankPoints(Player());",
                        "                pointsReserved = pointsReserved + k;",
                        "                if(ShipPirateRankPoints(Player()) > ShipNextPirateRankPoints(Player())) ShipPirateRankPoints(Player(),ShipNextPirateRankPoints(Player()));",
                        "            }",
                        "        }",
                        "        lastRankPoints = ShipRankPoints(Player());",
                        "        lastPirateRankPoints = ShipPirateRankPoints(Player());",
                        "        lastProcessedTurn = CurTurn();",
                        "    }",
                        "}",
                        "else {",
                        "    if(pointsReserved > 0) {",
                        "        if(GetShipRuins(Player())) {",
                        "            if(ShipType(GetShipRuins(Player())) == 'PB') {",
                        "                if(ShipOnSidePirateClan(Player())) {",
                        "                    k = ShipPirateRankPoints(Player()) + pointsReserved;",
                        "                    if(GetShipPirateRank(Player()) < 7 && k > ShipNextPirateRankPoints(Player())) {",
                        "                        pointsReserved = k - ShipNextPirateRankPoints(Player());",
                        "                        k = ShipNextPirateRankPoints(Player());",
                        "                    }",
                        "                    else pointsReserved = 0;",
                        "                    ShipPirateRankPoints(Player(),k);",
                        "                    lastPirateRankPoints = k;",
                        "                }",
                        "            }",
                        "            else if(ShipType(GetShipRuins(Player())) == 'WB') {",
                        "                if(!ShipOnSidePirateClan(Player())) {",
                        "                    k = ShipRankPoints(Player()) + pointsReserved;",
                        "                    if(ShipRank(Player()) < 7 && k > ShipNextRankPoints(Player())) {",
                        "                        pointsReserved = k - ShipNextRankPoints(Player());",
                        "                        k = ShipNextRankPoints(Player());",
                        "                    }",
                        "                    else pointsReserved = 0;",
                        "                    ShipRankPoints(Player(),k);",
                        "                    lastRankPoints = k;",
                        "                }",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                    ]
                }
            ],
